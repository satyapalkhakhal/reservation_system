# HTTPS reverse proxy for production (used by docker-compose.prod.yml).
# Caddy obtains and renews a Let's Encrypt certificate for $DOMAIN
# automatically; DNS for $DOMAIN must point at this server and ports
# 80 + 443 must be reachable.
{$DOMAIN} {
	encode gzip
	reverse_proxy app:3000 {
		transport http {
			# Reuse upstream connections instead of opening a new one per
			# request under bursts (Caddy's default keeps only 32 idle).
			keepalive_idle_conns_per_host 1024
			# Below Node/Fastify's 72s keep-alive timeout, so Caddy never
			# reuses a connection the app is about to close.
			keepalive 60s
		}
	}
}
