# HTTPS reverse proxy for production (used by docker-compose.prod.yml).
# Caddy obtains and renews a Let's Encrypt certificate for $DOMAIN
# automatically; DNS for $DOMAIN must point at this server and ports
# 80 + 443 must be reachable.
{$DOMAIN} {
	encode gzip
	reverse_proxy app:3000 {
		# Retry only failures to CONNECT to the app (e.g. during a restart).
		# The request was never sent, so this cannot double-book.
		lb_try_duration 5s
		transport http {
			# A fixed, reused set of connections to the app. Without a cap, a
			# burst of 20,000 clients becomes 20,000 new app connections and
			# throughput collapses; with it, excess requests queue here (cheap
			# in Go) and the app serves a steady stream.
			max_conns_per_host 512
			keepalive_idle_conns_per_host 512
			# Below Node/Fastify's 72s keep-alive timeout, so Caddy never
			# reuses a connection the app is about to close.
			keepalive 60s
		}
	}
}
