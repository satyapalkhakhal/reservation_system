# ---- Server ----
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ---- PostgreSQL ----
DATABASE_URL=postgresql://reservations:local-dev-password@localhost:55432/reservations
# disable | verify (TLS + certificate check) | no-verify (TLS, no check; avoid)
DATABASE_SSL_MODE=disable
# Optional PEM CA bundle for DATABASE_SSL_MODE=verify with a private CA
# DATABASE_CA_CERT=
DB_POOL_MAX=20
DB_POOL_ACQUIRE_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=15000

# ---- Domain ----
PER_USER_LIMIT=4

# ---- Auth ----
# At least 32 chars. Generate: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ISSUER=seat-reservation
JWT_TTL_SECONDS=3600
# Exposes POST /auth/dev-token (issues a token for any user_id). Demo/eval only.
AUTH_DEV_TOKENS_ENABLED=true
# User ids (token "sub") allowed to create shows (POST /shows), comma-separated.
ADMIN_USER_IDS=admin

# ---- docker compose overrides (optional) ----
# POSTGRES_USER=reservations
# POSTGRES_PASSWORD=local-dev-password
# POSTGRES_DB=reservations
# POSTGRES_HOST_PORT=55432
# APP_HOST_PORT=3000

# ---- production overlay (docker-compose.prod.yml) ----
# Public hostname served over HTTPS by Caddy; its DNS A record must point here.
# DOMAIN=reservation.example.com

# ---- observability overlay (docker-compose.observability.yml) ----
# Grafana admin login (anonymous visitors get read-only access).
# GRAFANA_ADMIN_PASSWORD=change-me-to-something-long
